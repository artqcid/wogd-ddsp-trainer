{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "build-debug",
      "type": "shell",
      "command": "npx vite build --mode=development",
      "options": {
        "cwd": "${workspaceFolder}/webui"
      },
      "group": "build",
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      }
    },
    {
      "label": "clean-build-debug",
      "type": "shell",
      "command": "Remove-Item -Recurse -Force dist -ErrorAction SilentlyContinue; npx vite build --mode=development",
      "options": {
        "cwd": "${workspaceFolder}/webui"
      },
      "group": "build",
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      }
    },
    {
      "label": "build-release",
      "type": "shell",
      "command": "npx vite build",
      "options": {
        "cwd": "${workspaceFolder}/webui"
      },
      "group": "build",
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      }
    },
    {
      "label": "clean-build-release",
      "type": "shell",
      "command": "Remove-Item -Recurse -Force dist -ErrorAction SilentlyContinue; npx vite build",
      "options": {
        "cwd": "${workspaceFolder}/webui"
      },
      "group": "build",
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      }
    },
    {
      "label": "start-debug",
      "type": "shell",
      "command": "${workspaceFolder}/scripts/start-app.ps1 -Mode Debug",
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      }
    },
    {
      "label": "start-release",
      "type": "shell",
      "command": "${workspaceFolder}/scripts/start-app.ps1 -Mode Release",
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      }
    },
    {
      "label": "stop-app",
      "type": "shell",
      "command": "${workspaceFolder}/scripts/stop-app.ps1 -Mode Debug",
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      }
    }
  ]
}