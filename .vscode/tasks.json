{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "build-debug",
      "type": "shell",
      "command": "npx vite build --mode=development",
      "options": {
        "cwd": "${workspaceFolder}/webui"
      },
      "group": "build",
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      }
    },
    {
      "label": "clean-build-debug",
      "type": "shell",
      "command": "Remove-Item -Recurse -Force dist -ErrorAction SilentlyContinue; npx vite build --mode=development",
      "options": {
        "cwd": "${workspaceFolder}/webui"
      },
      "group": "build",
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      }
    },
    {
      "label": "build-release",
      "type": "shell",
      "command": "npx vite build",
      "options": {
        "cwd": "${workspaceFolder}/webui"
      },
      "group": "build",
      "problemMatcher": []
    },
    {
      "label": "clean-build-release",
      "type": "shell",
      "command": "Remove-Item -Recurse -Force dist -ErrorAction SilentlyContinue; npx vite build",
      "options": {
        "cwd": "${workspaceFolder}/webui"
      },
      "group": "build",
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      }
    },
    {
      "label": "build-installer",
      "type": "shell",
      "command": "pwsh ${workspaceFolder}/scripts/build-installer.ps1",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": "build",
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      },
      "problemMatcher": []
    },
    {
      "label": "e2e-test",
      "type": "shell",
      "command": "${workspaceFolder}/.venv/Scripts/python.exe -m pytest tests/e2e",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": "test",
      "problemMatcher": []
    },
    {
      "label": "start-application-debug",
      "type": "shell",
      "command": "pwsh ${workspaceFolder}/scripts/start-app.ps1 -Mode Debug",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      },
      "problemMatcher": []
    },
    {
      "label": "start-application-release",
      "type": "shell",
      "command": "pwsh ${workspaceFolder}/scripts/start-app.ps1 -Mode Release",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      },
      "problemMatcher": []
    },
    {
      "label": "stop-application-debug",
      "type": "shell",
      "command": "pwsh ${workspaceFolder}/scripts/stop-app.ps1 -Mode Debug",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      },
      "problemMatcher": []
    },
    {
      "label": "stop-application-release",
      "type": "shell",
      "command": "pwsh ${workspaceFolder}/scripts/stop-app.ps1 -Mode Release",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      },
      "problemMatcher": []
    }
  ]
}